        "/api/recurring-bills": {
            "get": {
                "tags": [
                    "RecurringBills"
                ],
                "summary": "Listar contas fixas do usuário",
                "operationId": "b1fff6f9b6e18927a8218c46c4dc027b",
                "responses": {
                    "200": {
                        "description": "Contas fixas listadas com sucesso"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "RecurringBills"
                ],
                "summary": "Criar conta fixa",
                "operationId": "7cca992ae5592026a1de6f8fb421b82f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "account_id",
                                    "name",
                                    "type",
                                    "amount",
                                    "day_of_month",
                                    "start_date"
                                ],
                                "properties": {
                                    "account_id": {
                                        "type": "integer"
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Aluguel"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "income",
                                            "expense"
                                        ]
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500
                                    },
                                    "day_of_month": {
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "active",
                                            "paused",
                                            "cancelled"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Conta fixa criada com sucesso"
                    },
                    "422": {
                        "description": "Dados inválidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
